/target/

# Tauri generated files and fetched binaries (see scripts/fetch-ffmpeg.ps1)
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/bin/

# Pre-restructure leftovers (old layout; safe to delete locally)
/src-tauri/
/node_modules/
/dist/

# Frontend dependencies and build output
node_modules/
dist/

# Environment variables and secrets
.env
.env.*
!.env.example

# Logs and runtime data
*.log
npm-debug.log*

# Agent scratch space
.superpowers/

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Benchmark logs are part of the published dataset
!docs/benchmarks/**/*.log
