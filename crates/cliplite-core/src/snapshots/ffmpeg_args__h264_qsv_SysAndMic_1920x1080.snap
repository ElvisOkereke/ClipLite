---
source: src/rec_ffmpeg_tests.rs
---
[
    "C:\\ff mpeg\\ffmpeg.exe",
    "-y",
    "-f",
    "f32le",
    "-ar",
    "48000",
    "-ac",
    "2",
    "-thread_queue_size",
    "4096",
    "-i",
    "\\\\.\\pipe\\cliplite_sysaudio_replay",
    "-f",
    "lavfi",
    "-i",
    "ddagrab=output_idx=0:framerate=60:draw_mouse=1",
    "-map",
    "1:v",
    "-map",
    "0:a",
    "-c:v",
    "h264_qsv",
    "-pix_fmt",
    "yuv420p",
    "-b:v",
    "8M",
    "-af",
    "aresample=async=1000",
    "-c:a",
    "aac",
    "-b:a",
    "128k",
    "-movflags",
    "+faststart",
    "C:\\out dir\\clip.mp4",
]
