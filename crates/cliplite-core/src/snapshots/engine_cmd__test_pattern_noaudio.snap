---
source: crates/cliplite-core/src/ffmpeg_tests.rs
---
[
    "C:\\ff mpeg\\ffmpeg.exe",
    "-re",
    "-f",
    "lavfi",
    "-i",
    "testsrc2=s=1920x1080:r=30",
    "-map",
    "0:v",
    "-c:v",
    "libx264",
    "-pix_fmt",
    "yuv420p",
    "-crf",
    "23",
    "-preset",
    "superfast",
    "-maxrate",
    "8M",
    "-bufsize",
    "16M",
    "-threads",
    "0",
    "-g",
    "30",
    "-keyint_min",
    "30",
    "-an",
    "-pes_payload_size",
    "0",
    "-mpegts_flags",
    "+resend_headers",
    "-f",
    "mpegts",
    "pipe:1",
]
